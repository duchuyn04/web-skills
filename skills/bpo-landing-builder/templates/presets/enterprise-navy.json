    "light": {"bg": "#ffffff", "surface": "#ffffff", "surface_2": "#f3f6fb", "text": "#475569", "text_strong": "$primary", "text_muted": "#64748b", "border": "#e2e8f0", "is_dark": false},
    "muted": {"bg": "#f5f7fb", "surface": "#ffffff", "surface_2": "#eaeff7", "text": "#475569", "text_strong": "$primary", "text_muted": "#64748b", "border": "#dfe5ee", "is_dark": false},
    "dark": {"bg": "$primary", "surface": "mix($primary,#ffffff,0.05)", "surface_2": "mix($primary,#ffffff,0.09)", "text": "#b4c0d4", "text_strong": "#ffffff", "text_muted": "#8796b0", "border": "rgba(255,255,255,0.11)", "is_dark": true}
  }
}
