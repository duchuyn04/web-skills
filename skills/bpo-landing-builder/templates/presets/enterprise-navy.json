  "use_for": "Large CX and enterprise BPO groups that sell to banks, telcos and healthcare. Serious, high contrast.",
  "references": ["Concentrix", "Conduent", "Teleperformance", "Startek", "TDCX"],
  "fonts": {
    "heading": "Montserrat",
