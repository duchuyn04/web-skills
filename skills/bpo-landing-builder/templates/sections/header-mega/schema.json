{
  "variant": "header-mega",
  "group": "header",
  "forms": ["header"],
  "summary": "Fixed header with utility top bar, language switcher (SVG flags) and one or two megamenu dropdowns. For multi-service enterprise brands.",
  "tone": "header",
  "anchor": "site-header",
  "shared": ["header"],
  "animations": ["header-shrink-blur", "megamenu-slide-fade", "magnetic-cta-button (features.magnetic_cta)"],
  "fields": {
    "topbar": {
      "type": "object", "required": false,
      "fields": {
        "note": {"type": "text", "min": 8, "max": 70},
        "links": {"type": "list", "min": 0, "max": 3, "default": [], "item": {"$ref": "cta"}}
      }
    },
    "languages": {
      "type": "list", "min": 0, "max": 6, "default": [],
      "item": {"type": "object", "fields": {
        "flag": {"type": "flag"},
        "label": {"type": "text", "min": 2, "max": 24},
        "href": {"type": "href"},
        "current": {"type": "bool", "default": false}
      }}
    },
    "links": {
      "type": "list", "min": 3, "max": 6,
      "item": {"type": "object", "fields": {
        "label": {"type": "text", "min": 2, "max": 18},
        "href": {"type": "href"},
        "mega": {
          "type": "object", "required": false,
          "fields": {
            "columns": {"type": "list", "min": 1, "max": 3, "item": {"type": "object", "fields": {
              "heading": {"type": "text", "min": 3, "max": 28},
              "links": {"type": "list", "min": 2, "max": 6, "item": {"$ref": "cta"}}
            }}},
            "featured": {"type": "object", "required": false, "fields": {
              "tag": {"type": "text", "min": 3, "max": 20},
              "title": {"type": "text", "min": 10, "max": 70},
              "text": {"type": "text", "min": 20, "max": 140},
              "link_label": {"type": "text", "min": 3, "max": 24},
              "href": {"type": "href"}
            }}
          }
        }
      }}
    },
    "cta": {"$ref": "cta"},
    "menu_label": {"type": "text", "min": 2, "max": 16, "default": "Menu"},
    "close_label": {"type": "text", "min": 2, "max": 16, "default": "Close menu"}
  }
}
