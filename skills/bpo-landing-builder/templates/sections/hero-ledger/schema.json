{
  "variant": "hero-ledger",
  "group": "hero", "signature": true,
  "forms": ["hero-split"],
  "summary": "Split hero for accounting, payroll and back-office work: copy left, a photo of paperwork right with two or three report sheets fanned over its lower corner. On arrival the sheets slide in, their ruled lines fill and are ticked off one by one and a small trend line draws itself; afterwards the sheets lean slightly with the pointer. No numbers are shown on the sheets, only row names. Needs a desk or document photo, 2-3 report names with 3-4 row names each, and the usual hero copy.",
  "tone": "hero",
  "anchor": "top",
  "shared": ["hero"],
  "animations": ["report-sheets-fan-in", "ledger-rows-tick", "trend-line-draw", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 44, "required": false},
    "title": {"type": "markup", "min": 12, "max": 90},
    "lead": {"type": "text", "min": 60, "max": 230},
    "primary_cta": {"$ref": "cta"},
    "secondary_cta": {"$ref": "cta", "required": false},
    "proof": {"type": "list", "min": 0, "max": 3, "default": [], "item": {"type": "text", "min": 3, "max": 36}},
    "photo": {"$ref": "photo"},
    "sheets": {"type": "list", "min": 2, "max": 3, "item": {"type": "object", "fields": {
      "tag": {"type": "text", "min": 2, "max": 24},
      "title": {"type": "text", "min": 4, "max": 40},
      "rows": {"type": "list", "min": 3, "max": 4, "item": {"type": "text", "min": 3, "max": 28}}
    }}},
    "stats": {"type": "list", "min": 0, "max": 4, "default": [], "item": {"type": "object", "fields": {
      "value": {"type": "text", "min": 1, "max": 12},
      "label": {"type": "text", "min": 3, "max": 36}
    }}}
  }
}
