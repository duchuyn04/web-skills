{
  "variant": "hero-voice",
  "group": "hero", "signature": true,
  "forms": ["hero-split"],
  "summary": "Split hero for multilingual contact centers: copy left, a large photo of the team right with the languages the center answers in as chips, and a call card over the photo that answers in each language in turn (the greeting changes, a voice level meter moves while it speaks). Stats strip below. Needs a team or agent photo, 2-6 greetings in the languages the brief names, and the usual hero copy.",
  "tone": "hero",
  "anchor": "top",
  "shared": ["hero"],
  "animations": ["multilingual-greeting-card", "voice-level-meter", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 44, "required": false},
    "title": {"type": "markup", "min": 12, "max": 90},
    "lead": {"type": "text", "min": 60, "max": 230},
    "primary_cta": {"$ref": "cta"},
    "secondary_cta": {"$ref": "cta", "required": false},
    "proof": {"type": "list", "min": 0, "max": 3, "default": [], "item": {"type": "text", "min": 3, "max": 36}},
    "photo": {"$ref": "photo"},
    "call_label": {"type": "text", "min": 3, "max": 30, "default": "Answering now"},
    "languages_label": {"type": "text", "min": 3, "max": 40, "default": "Languages we answer in"},
    "greetings": {"type": "list", "min": 2, "max": 6, "item": {"type": "object", "fields": {
      "language": {"type": "text", "min": 2, "max": 20},
      "text": {"type": "text", "min": 6, "max": 70}
    }}},
    "stats": {"type": "list", "min": 0, "max": 4, "default": [], "item": {"type": "object", "fields": {
      "value": {"type": "text", "min": 1, "max": 12},
      "label": {"type": "text", "min": 3, "max": 36}
    }}},
    "pause_label": {"type": "text", "min": 3, "max": 30, "default": "Pause animations"},
    "play_label": {"type": "text", "min": 3, "max": 30, "default": "Play animations"}
  }
}
