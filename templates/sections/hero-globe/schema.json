{
  "variant": "hero-globe",
  "group": "hero", "signature": true,
  "forms": ["hero-split"],
  "summary": "Hero with a dotted 3D globe on the right: land drawn in evenly spaced dots, the company's delivery hubs pinned in the brand colour with their city names, and arcs to the client markets with a light pulse running along each one. The globe sways around the hubs and leans toward the pointer. Rotation and pulse timing are seeded from the brand name. Needs 1-4 delivery cities from the brief (keys from templates/data/cities.json or {name, country, lat, lon}) and optionally up to 6 client market cities; fits offshore staffing, nearshore and multi-site contact centers.",
  "tone": "hero",
  "anchor": "top",
  "shared": ["hero", "ribbons", "scene3d", "three", "gl", "gl-globe"],
  "animations": ["dotted-globe-arcs-3d", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 44, "required": false},
    "title": {"type": "markup", "min": 12, "max": 90},
    "lead": {"type": "text", "min": 60, "max": 230},
    "primary_cta": {"$ref": "cta"},
    "secondary_cta": {"$ref": "cta", "required": false},
    "proof": {"type": "list", "min": 0, "max": 3, "default": [], "item": {"type": "text", "min": 3, "max": 36}},
    "globe_label": {"type": "text", "min": 3, "max": 40, "default": "Where we work"},
    "hubs": {"type": "list", "min": 1, "max": 4, "item": {"type": "object", "fields": {
      "city": {"type": "city"}
    }}},
    "markets": {"type": "list", "min": 0, "max": 6, "default": [], "item": {"type": "object", "fields": {
      "city": {"type": "city"}
    }}},
    "stats": {"type": "list", "min": 0, "max": 4, "default": [], "item": {"type": "object", "fields": {
      "value": {"type": "text", "min": 1, "max": 12},
      "label": {"type": "text", "min": 3, "max": 32}
    }}},
    "pause_label": {"type": "text", "min": 3, "max": 30, "default": "Pause animations"},
    "play_label": {"type": "text", "min": 3, "max": 30, "default": "Play animations"}
  }
}
