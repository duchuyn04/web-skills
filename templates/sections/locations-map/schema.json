{
  "variant": "locations-map",
  "group": "locations",
  "summary": "Dotted world map with radar-pulse pins for each delivery hub (hover or focus shows headcount and detail), plus a row of hub cards with SVG flags.",
  "tone": "auto",
  "anchor": "locations",
  "animations": ["interactive-map-pin-pulse", "reveal"],
  "fields": {
    "head": {"$ref": "head"},
    "hubs": {
      "type": "list", "min": 2, "max": 8,
      "item": {"type": "object", "fields": {
        "city": {"type": "city"},
        "role": {"type": "text", "min": 3, "max": 34},
        "headcount": {"type": "text", "min": 1, "max": 20},
        "detail": {"type": "text", "min": 5, "max": 80}
      }}
    }
  }
}
