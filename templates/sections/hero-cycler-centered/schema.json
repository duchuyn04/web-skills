{
  "variant": "hero-cycler-centered",
  "group": "hero",
  "forms": ["hero-center"],
  "summary": "Centered headline whose last words rotate through 3-6 service names, lead, CTAs, proof ticks and an optional wide photo stage with floating KPI badges.",
  "tone": "hero",
  "anchor": "top",
  "shared": ["hero"],
  "animations": ["kinetic-typography-cycler", "floating-glass-badges", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 44, "required": false},
    "title_before": {"type": "markup", "min": 6, "max": 60},
    "words": {"type": "list", "min": 3, "max": 6, "item": {"type": "text", "min": 3, "max": 26}},
    "title_after": {"type": "text", "min": 2, "max": 40, "required": false},
    "lead": {"type": "text", "min": 60, "max": 230},
    "primary_cta": {"$ref": "cta"},
    "secondary_cta": {"$ref": "cta", "required": false},
    "proof": {"type": "list", "min": 0, "max": 4, "default": [], "item": {"type": "text", "min": 3, "max": 36}},
    "photo": {"$ref": "photo", "required": false},
    "badges": {
      "type": "list", "min": 0, "max": 3, "default": [],
      "item": {"type": "object", "fields": {
        "icon": {"type": "icon"},
        "value": {"type": "text", "min": 1, "max": 14},
        "label": {"type": "text", "min": 3, "max": 30}
      }}
    }
  }
}
