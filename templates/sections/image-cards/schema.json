{
  "variant": "image-cards",
  "group": "cards",
  "forms": ["cards-image", "carousel-cards"],
  "open": true,
  "summary": "Clickable photo cards with tag, meta line, title and short text. Grid of 3, 4 or 6 cards, or a draggable slider of 3 to 8 cards when \"slider\" is true. Use for insights and news, industries with photos, or solution pages. Optional 'view all' link next to the heading.",
  "tone": "auto",
  "anchor": "insights",
  "shared": ["slider"],
  "animations": ["reveal", "card-photo-open", "card-copy-follow", "fluid-case-study-slider (slider mode)", "cards-slide-in (slider mode)"],
  "fields": {
    "head": {"$ref": "head"},
    "view_all": {"$ref": "cta", "required": false},
    "ratio": {"type": "enum", "values": ["wide", "tall"], "default": "wide"},
    "slider": {"type": "bool", "default": false},
    "prev_label": {"type": "text", "min": 2, "max": 20, "default": "Previous"},
    "next_label": {"type": "text", "min": 2, "max": 20, "default": "Next"},
    "cards": {
      "type": "list", "min": 3, "max": 8,
      "item": {"type": "object", "fields": {
        "tag": {"type": "text", "min": 2, "max": 20, "required": false},
        "meta": {"type": "text", "min": 2, "max": 28, "required": false},
        "title": {"type": "text", "min": 10, "max": 90},
        "text": {"type": "text", "min": 20, "max": 160, "required": false},
        "photo": {"$ref": "photo"},
        "href": {"type": "href"},
        "link_label": {"type": "text", "min": 2, "max": 24, "default": "Read more"}
      }}
    }
  }
}
