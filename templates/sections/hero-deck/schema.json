{
  "variant": "hero-deck",
  "group": "hero", "signature": true, "tier": "expressive",
  "forms": ["hero-split"],
  "summary": "Hero with a deck of role cards on the right (role title, icon, 2-3 skills, optional seniority or language note). The cards fan out in 3D as the hero appears; every 2.8 s the front card slides out and goes to the back until the deck returns to the first role, then it stops. A Next role button steps the deck by hand, the page-wide Pause switch stops it, and hovering spreads the fan. Fan angle, lean, direction and card tints are seeded from the brand name. Needs 4-7 real roles the company staffs; fits staff augmentation, dedicated teams and offshore staffing. Cards show roles only, never names or photos of people.",
  "tone": "hero",
  "anchor": "top",
  "shared": ["hero", "ribbons", "scene3d", "stage3d"],
  "animations": ["role-deck-fan-3d", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 44, "required": false},
    "title": {"type": "markup", "min": 12, "max": 90},
    "lead": {"type": "text", "min": 60, "max": 230},
    "primary_cta": {"$ref": "cta"},
    "secondary_cta": {"$ref": "cta", "required": false},
    "proof": {"type": "list", "min": 0, "max": 3, "default": [], "item": {"type": "text", "min": 3, "max": 36}},
    "deck_label": {"type": "text", "min": 3, "max": 28, "default": "Roles we staff"},
    "next_label": {"type": "text", "min": 3, "max": 20, "default": "Next role"},
    "roles": {"type": "list", "min": 4, "max": 7, "item": {"type": "object", "fields": {
      "icon": {"type": "icon"},
      "title": {"type": "text", "min": 3, "max": 28},
      "skills": {"type": "list", "min": 2, "max": 3, "item": {"type": "text", "min": 2, "max": 20}},
      "meta": {"type": "text", "min": 2, "max": 12, "required": false}
    }}},
    "stats": {"type": "list", "min": 0, "max": 4, "default": [], "item": {"type": "object", "fields": {
      "value": {"type": "text", "min": 1, "max": 12},
      "label": {"type": "text", "min": 3, "max": 32}
    }}},
    "pause_label": {"type": "text", "min": 3, "max": 30, "default": "Pause animations"},
    "play_label": {"type": "text", "min": 3, "max": 30, "default": "Play animations"}
  }
