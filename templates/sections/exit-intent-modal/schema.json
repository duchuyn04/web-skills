{
  "variant": "exit-intent-modal",
  "group": "floating",
  "forms": ["floating"],
  "summary": "Desktop-only modal that opens with a spring when the pointer leaves toward the browser bar, after 8 seconds on page. Shown at most once every 7 days.",
  "tone": "none",
  "anchor": "exit-offer",
  "animations": ["exit-intent-spring-modal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 36, "required": false},
    "title": {"type": "text", "min": 20, "max": 90},
    "text": {"type": "text", "min": 40, "max": 220},
    "cta": {"$ref": "cta"},
    "dismiss_label": {"type": "text", "min": 2, "max": 24, "default": "No thanks"},
    "close_label": {"type": "text", "min": 2, "max": 16, "default": "Close"}
  }
}
