{
  "variant": "hero-split-image",
  "group": "hero",
  "summary": "Headline, lead and two CTAs on the left; large photo on the right with up to 3 floating glass KPI badges.",
  "tone": "hero",
  "anchor": "top",
  "shared": ["hero"],
  "animations": ["floating-glass-badges", "shimmer-button-glow", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 44, "required": false},
    "title": {"type": "markup", "min": 12, "max": 90},
    "lead": {"type": "text", "min": 60, "max": 230},
    "primary_cta": {"$ref": "cta"},
    "secondary_cta": {"$ref": "cta", "required": false},
    "proof": {"type": "list", "min": 0, "max": 3, "default": [], "item": {"type": "text", "min": 3, "max": 36}},
    "photo": {"$ref": "photo"},
    "badges": {
      "type": "list", "min": 0, "max": 3, "default": [],
      "item": {"type": "object", "fields": {
        "icon": {"type": "icon"},
        "value": {"type": "text", "min": 1, "max": 14},
        "label": {"type": "text", "min": 3, "max": 30}
      }}
    }
  }
}
