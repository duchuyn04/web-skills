{
  "variant": "hero-dark-network",
  "group": "hero",
  "summary": "Dark hero over an animated canvas node network that tilts with the mouse; copy on the left, a live operations panel on the right, optional KPI chips.",
  "tone": "dark",
  "anchor": "top",
  "shared": ["hero"],
  "animations": ["hero-3d-point-cloud-nodes", "shimmer-button-glow", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 44, "required": false},
    "title": {"type": "markup", "min": 20, "max": 90},
    "lead": {"type": "text", "min": 60, "max": 230},
    "primary_cta": {"$ref": "cta"},
    "secondary_cta": {"$ref": "cta", "required": false},
    "panel": {"type": "object", "fields": {
      "title": {"type": "text", "min": 3, "max": 36},
      "status": {"type": "text", "min": 2, "max": 16},
      "rows": {"type": "list", "min": 3, "max": 5, "item": {"type": "object", "fields": {
        "label": {"type": "text", "min": 3, "max": 34},
        "value": {"type": "text", "min": 1, "max": 14}
      }}}
    }},
    "chips": {"type": "list", "min": 0, "max": 4, "default": [], "item": {"type": "object", "fields": {
      "value": {"type": "text", "min": 1, "max": 12},
      "label": {"type": "text", "min": 3, "max": 28}
    }}}
  }
}
