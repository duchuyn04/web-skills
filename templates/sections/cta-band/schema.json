  "anchor": "get-started",
  "animations": ["shimmer-button-glow", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 40, "required": false},
    "title": {"type": "markup", "min": 12, "max": 80},
    "text": {"type": "text", "min": 30, "max": 200, "required": false},
    "points": {"type": "list", "min": 0, "max": 3, "default": [], "item": {"type": "text", "min": 3, "max": 40}},
    "primary_cta": {"$ref": "cta"},
    "secondary_cta": {"$ref": "cta", "required": false},
    "image": {"type": "image", "required": false}
  }
}
