{
  "variant": "metrics-counter",
  "group": "metrics",
  "summary": "Dark band with a short heading and 3-4 large numbers that count up once when scrolled into view.",
  "tone": "dark",
  "anchor": "results",
  "animations": ["odometer-number-counter", "reveal"],
  "fields": {
    "eyebrow": {"type": "text", "min": 3, "max": 40, "required": false},
    "title": {"type": "markup", "min": 6, "max": 80},
    "lead": {"type": "text", "min": 40, "max": 200, "required": false},
    "items": {
      "type": "list", "min": 3, "max": 4,
      "item": {"type": "object", "fields": {
        "value": {"type": "stat"},
        "prefix": {"type": "text", "min": 1, "max": 3, "required": false},
        "suffix": {"type": "text", "min": 1, "max": 6, "required": false},
        "decimals": {"type": "number", "min": 0, "max": 2, "required": false},
        "label": {"type": "text", "min": 3, "max": 40},
        "note": {"type": "text", "min": 5, "max": 80, "required": false}
      }}
    }
  }
}
