{
  "variant": "metrics-counter",
  "group": "metrics",
  "forms": ["metrics"],
  "summary": "Dark band with a short heading and 3-4 large numbers that count up once when scrolled into view. Optional \"image\": a real photo (team, floor, office) fills the band behind the numbers under a solid scrim in the section colour and drifts slightly slower than the page while scrolling. When \"visual\" is also set, \"visual\" wins and the photo is not shown.",
  "tone": "dark",
  "anchor": "results",
  "shared": ["backdrop3d"],
  "shared_by_field": {"visual": {"*": ["ribbons", "three", "gl"], "dots": ["gl-dots"], "terrain": ["gl-terrain"], "wave": ["gl-wave"], "globe": ["gl-globe"], "flow": ["gl-flow"]}},
  "animations": ["odometer-number-counter", "metric-rule-draw", "photo-band-parallax", "reveal"],
  "fields": {
    "visual": {"type": "enum", "values": ["dots", "terrain", "wave", "globe", "flow"], "required": false},
    "image": {"type": "image", "required": false},
    "eyebrow": {"type": "text", "min": 3, "max": 40, "required": false},
    "title": {"type": "markup", "min": 6, "max": 80},
    "lead": {"type": "text", "min": 40, "max": 200, "required": false},
    "items": {
      "type": "list", "min": 2, "max": 4,
      "item": {"type": "object", "fields": {
        "value": {"type": "stat"},
        "prefix": {"type": "text", "min": 1, "max": 3, "required": false},
        "suffix": {"type": "text", "min": 1, "max": 6, "required": false},
        "decimals": {"type": "number", "min": 0, "max": 2, "required": false},
        "label": {"type": "text", "min": 3, "max": 40},
        "note": {"type": "text", "min": 5, "max": 80, "required": false}
      }}
    }
  }
}
