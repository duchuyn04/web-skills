{
  "name": "teal-fresh",
  "label": "Teal fresh",
  "use_for": "Young CX, staffing and AI data startups that want a friendly, modern feel: deep teal with a mint highlight, big rounded corners, arched photos and brand-colour highlights.",
  "references": ["Foundever", "Emapta", "Humans in the Loop", "Boldr", "Sama"],
  "fonts": {
    "heading": "Outfit",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "google": "family=Outfit:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600"
  },
  "type": {"heading_weight": 600, "heading_tracking": "-0.025em"},
  "colors": {"primary": "#0b2b2a", "accent": "#0a7f78", "accent_2": "#34d399"},
  "shape": {"radius_sm": "10px", "radius": "16px", "radius_lg": "24px", "radius_btn": "999px"},
  "hero_tone": "light",
  "eyebrow": "pill",
  "design": {"edges": "curve", "image_mask": "arch", "highlight": "color", "media_reveal": "clip"},
  "tone_cycle": ["light", "muted"],
  "tones": {
    "light": {"bg": "#ffffff", "surface": "#ffffff", "surface_2": "#eef8f5", "text": "#3f5552", "text_strong": "$primary", "text_muted": "#5b706d", "border": "#dcebe7", "is_dark": false},
    "muted": {"bg": "#f1f9f6", "surface": "#ffffff", "surface_2": "#e3f3ee", "text": "#3f5552", "text_strong": "$primary", "text_muted": "#5b706d", "border": "#d3e7e1", "is_dark": false},
    "dark": {"bg": "$primary", "surface": "mix($primary,#ffffff,0.06)", "surface_2": "mix($primary,#ffffff,0.11)", "text": "#b9d4cf", "text_strong": "#ffffff", "text_muted": "#8fb0aa", "border": "rgba(255,255,255,0.12)", "is_dark": true}
  }
}
